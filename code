:root {
  --ink: #0b1016;
  --ink-soft: rgba(11, 16, 22, 0.78);
  --paper: #edf1f3;
  --paper-dim: rgba(237, 241, 243, 0.62);
  --blue: #2c6db0;
  --blue-light: #83bfe7;
  --red: #e64949;
  --yellow: #e6c65b;
  --line: rgba(237, 241, 243, 0.36);
  --line-soft: rgba(237, 241, 243, 0.17);
  --shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--ink);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  overflow: hidden;
  color: var(--paper);
  background: var(--ink);
  font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", Arial, sans-serif;
}

button,
input {
  font: inherit;
}

button {
  color: inherit;
}

button:focus-visible,
input:focus-visible {
  outline: 2px solid var(--yellow);
  outline-offset: 3px;
}

.app-shell {
  position: relative;
  min-height: 100svh;
  overflow: hidden;
  isolation: isolate;
  background: var(--ink);
}

.backdrop-video,
.video-tint,
.blueprint-grid,
.grain {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.backdrop-video {
  z-index: 0;
  object-fit: cover;
  background: #e8ecef;
  filter: saturate(0.78) contrast(0.94) brightness(1.02);
}

.video-tint {
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(6, 11, 16, 0.66), transparent 26%, transparent 74%, rgba(6, 11, 16, 0.54)),
    linear-gradient(0deg, rgba(7, 12, 18, 0.78), transparent 26%, rgba(10, 16, 22, 0.08) 72%, rgba(7, 12, 18, 0.35));
  mix-blend-mode: multiply;
}

.blueprint-grid {
  z-index: 2;
  pointer-events: none;
  opacity: 0.44;
  background-image:
    linear-gradient(rgba(32, 95, 154, 0.2) 1px, transparent 1px),
    linear-gradient(90deg, rgba(32, 95, 154, 0.2) 1px, transparent 1px),
    linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
  background-position: center;
  background-size: 112px 112px, 112px 112px, 28px 28px, 28px 28px;
  mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
}

.grain {
  z-index: 10;
  pointer-events: none;
  opacity: 0.07;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.68'/%3E%3C/svg%3E");
  mix-blend-mode: screen;
}

.main-stage {
  z-index: 3;
}

.ui-layer {
  position: relative;
  z-index: 4;
}

.topbar {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  min-height: 82px;
  padding: 14px 24px 14px 18px;
  border-bottom: 1px solid var(--line-soft);
  background: linear-gradient(90deg, rgba(6, 11, 16, 0.82), rgba(6, 11, 16, 0.15));
}

.topbar-left {
  display: flex;
  align-items: stretch;
  gap: 1px;
}

.square-button,
.home-button,
.dock-icon,
.panel-close {
  border: 1px solid var(--line);
  background: rgba(7, 12, 17, 0.6);
  cursor: pointer;
  transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease;
}

.square-button:hover,
.home-button:hover,
.dock-icon:hover,
.panel-close:hover {
  border-color: var(--paper);
  background: rgba(7, 12, 17, 0.9);
}

.square-button {
  display: grid;
  place-items: center;
  width: 58px;
  min-width: 58px;
  font-family: Georgia, serif;
  font-size: 38px;
  font-weight: 300;
  line-height: 1;
}

.home-button {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 246px;
  padding: 11px 18px;
  text-align: left;
}

.home-mark {
  position: relative;
  display: block;
  width: 30px;
  height: 30px;
  border: 1px solid rgba(237, 241, 243, 0.8);
  transform: rotate(45deg);
}

.home-mark::before,
.home-mark::after {
  position: absolute;
  content: "";
  inset: 5px;
  border: 1px solid var(--blue-light);
}

.home-mark::after {
  inset: 10px;
  border-color: var(--red);
}

.home-button strong,
.home-button small,
.tab-copy strong,
.tab-copy small {
  display: block;
}

.home-button strong {
  font-size: 15px;
  letter-spacing: 0.12em;
}

.home-button small {
  margin-top: 4px;
  color: var(--paper-dim);
  font: 10px/1 "Consolas", "Courier New", monospace;
  letter-spacing: 0.08em;
}

.topbar-status {
  display: flex;
  align-items: center;
  gap: 18px;
  padding-right: 5px;
}

.status-item {
  display: grid;
  gap: 4px;
  min-width: 92px;
}

.status-label,
.section-code,
.top-note,
.tab-copy small,
.runtime-label,
.dock-copy,
.panel-topline,
.readout-kicker {
  font: 10px/1.2 "Consolas", "Courier New", monospace;
  letter-spacing: 0.12em;
}

.status-label {
  color: var(--paper-dim);
}

.status-item strong {
  font: 600 12px/1 "Consolas", "Courier New", monospace;
}

.status-rule {
  width: 1px;
  height: 32px;
  background: var(--line);
}

.status-light {
  display: block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 5px rgba(230, 73, 73, 0.12), 0 0 18px rgba(230, 73, 73, 0.8);
}

.main-stage {
  position: relative;
  min-height: calc(100svh - 146px);
}

.stage-heading {
  position: absolute;
  top: 10.5vh;
  left: clamp(24px, 6vw, 96px);
  width: min(460px, 38vw);
  text-shadow: 0 4px 22px rgba(0, 0, 0, 0.34);
}

.section-code {
  display: inline-block;
  margin-bottom: 14px;
  color: var(--yellow);
}

.stage-heading h1 {
  max-width: 440px;
  margin: 0;
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: clamp(50px, 7vw, 112px);
  font-weight: 400;
  line-height: 0.86;
  letter-spacing: 0.02em;
}

.stage-heading p {
  max-width: 320px;
  margin: 24px 0 0;
  color: var(--paper-dim);
  font-size: 15px;
  line-height: 1.8;
}

.top-note {
  position: absolute;
  top: 4.4vh;
  right: clamp(24px, 6vw, 96px);
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--paper-dim);
}

.top-note-index {
  color: var(--red);
}

.top-note-line {
  display: block;
  width: 68px;
  height: 1px;
  background: var(--line);
}

.scene-nav {
  position: absolute;
  top: 50%;
  right: clamp(24px, 5vw, 80px);
  display: grid;
  gap: 10px;
  width: 196px;
  transform: translateY(-50%);
}

.scene-tab {
  position: relative;
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 12px;
  align-items: center;
  min-height: 54px;
  padding: 9px 12px 9px 10px;
  border: 1px solid transparent;
  border-left-color: var(--line);
  color: var(--paper-dim);
  background: rgba(10, 16, 22, 0.34);
  cursor: pointer;
  text-align: left;
  transition: border-color 180ms ease, color 180ms ease, background 180ms ease, transform 180ms ease;
}

.scene-tab:hover,
.scene-tab.is-active {
  border-color: var(--paper);
  border-left-color: var(--red);
  color: var(--paper);
  background: rgba(10, 16, 22, 0.72);
  transform: translateX(-6px);
}

.scene-tab.is-active::before {
  position: absolute;
  top: 8px;
  bottom: 8px;
  left: -1px;
  width: 3px;
  content: "";
  background: var(--red);
}

.tab-index {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 1px solid currentColor;
  border-radius: 50%;
  font: 10px/1 "Consolas", "Courier New", monospace;
}

.tab-copy strong {
  font-size: 14px;
  font-weight: 500;
}

.tab-copy small {
  margin-top: 5px;
  color: currentColor;
  opacity: 0.64;
}

.center-readout {
  position: absolute;
  bottom: 18.5vh;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 12px;
  transform: translateX(-50%);
  text-align: center;
}

.readout-mark {
  display: block;
  width: 15px;
  height: 15px;
  border: 1px solid var(--paper);
  transform: rotate(45deg);
}

.readout-mark::after {
  display: block;
  width: 5px;
  height: 5px;
  margin: 4px;
  content: "";
  background: var(--red);
}

.center-readout small,
.center-readout strong {
  display: block;
}

.center-readout small {
  color: var(--paper-dim);
  font: 9px/1.2 "Consolas", "Courier New", monospace;
  letter-spacing: 0.14em;
}

.center-readout strong {
  margin-top: 4px;
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 18px;
  font-weight: 400;
}

.interaction-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}

.interaction-layer > * {
  pointer-events: auto;
}

.hotspot,
.map-node,
.order-card,
.story-entry {
  pointer-events: auto;
}

.hotspot {
  position: absolute;
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 10px;
  align-items: center;
  min-width: 160px;
  padding: 7px 10px 7px 7px;
  border: 1px solid rgba(237, 241, 243, 0.56);
  color: var(--paper);
  background: rgba(9, 14, 20, 0.52);
  box-shadow: 0 12px 26px rgba(0, 0, 0, 0.14);
  cursor: pointer;
  text-align: left;
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

.hotspot:hover {
  border-color: var(--yellow);
  background: rgba(9, 14, 20, 0.82);
  transform: translateY(-4px);
}

.hotspot-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border: 1px solid var(--blue-light);
  border-radius: 50%;
  color: var(--yellow);
  font: 14px/1 "Consolas", "Courier New", monospace;
}

.hotspot strong,
.hotspot small {
  display: block;
}

.hotspot strong {
  font-size: 14px;
  font-weight: 500;
}

.hotspot small {
  margin-top: 4px;
  color: var(--paper-dim);
  font: 9px/1 "Consolas", "Courier New", monospace;
  letter-spacing: 0.08em;
}

.hotspot-map {
  right: 28%;
  bottom: 17%;
}

.hotspot-orders {
  right: 29%;
  top: 18%;
}

.hotspot-story {
  left: 30%;
  bottom: 16%;
}

.hotspot-notebook {
  left: 15%;
  top: 23%;
}

.map-node {
  position: absolute;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 7px;
  align-items: center;
  min-width: 108px;
  padding: 5px 9px 5px 5px;
  border: 1px solid rgba(39, 88, 144, 0.75);
  color: #162433;
  background: rgba(239, 244, 247, 0.88);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);
  cursor: pointer;
  text-align: left;
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

.map-node:hover,
.map-node.is-selected {
  border-color: var(--red);
  background: rgba(255, 248, 227, 0.96);
  transform: translateY(-4px);
}

.map-node::before {
  display: block;
  width: 22px;
  height: 22px;
  border: 2px solid var(--blue);
  border-radius: 50%;
  content: "";
  background: rgba(255, 255, 255, 0.84);
}

.map-node strong {
  display: block;
  font: 600 12px/1 "Consolas", "Courier New", monospace;
}

.map-node small {
  display: block;
  margin-top: 4px;
  color: #59666e;
  font-size: 9px;
}

.map-node.mt5 { left: 9%; top: 45%; }
.map-node.mt6 { left: 22%; top: 52%; }
.map-node.mt7 { left: 37%; top: 47%; }
.map-node.mt8 { left: 52%; top: 40%; }
.map-node.mt9 { left: 67%; top: 32%; }
.map-node.mt10 { right: 8%; top: 18%; }
.map-node.mtst3 { right: 10%; top: 54%; }
.map-node.mtex1 { left: 13%; bottom: 17%; }

.order-stack {
  position: absolute;
  top: 16%;
  right: clamp(24px, 7vw, 110px);
  display: grid;
  gap: 8px;
  width: 224px;
}

.order-card {
  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: 10px;
  align-items: center;
  min-height: 50px;
  padding: 7px 10px 7px 7px;
  border: 1px solid var(--line);
  color: var(--paper);
  background: rgba(12, 18, 24, 0.7);
  cursor: pointer;
  text-align: left;
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

.order-card:hover,
.order-card.is-selected {
  border-color: var(--yellow);
  background: rgba(12, 18, 24, 0.9);
  transform: translateX(-5px);
}

.order-card::before {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid var(--blue-light);
  border-radius: 50%;
  color: var(--yellow);
  content: attr(data-order);
  font: 11px/1 "Consolas", "Courier New", monospace;
}

.order-card strong,
.order-card small {
  display: block;
}

.order-card strong {
  font-size: 12px;
  font-weight: 500;
}

.order-card small {
  margin-top: 4px;
  color: var(--paper-dim);
  font: 9px/1 "Consolas", "Courier New", monospace;
}

.order-card .order-state {
  color: var(--red);
  font: 9px/1 "Consolas", "Courier New", monospace;
}

.story-stack {
  position: absolute;
  top: 16%;
  right: clamp(22px, 7vw, 110px);
  display: grid;
  gap: 6px;
  width: 228px;
}

.story-entry {
  display: grid;
  grid-template-columns: 24px 1fr auto;
  gap: 8px;
  align-items: center;
  min-height: 46px;
  padding: 8px 10px;
  border: 1px solid var(--line-soft);
  color: var(--paper);
  background: rgba(9, 14, 20, 0.72);
  cursor: pointer;
  text-align: left;
  transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
}

.story-entry:hover,
.story-entry.is-selected {
  border-color: var(--paper);
  background: rgba(9, 14, 20, 0.9);
  transform: translateX(-5px);
}

.story-entry .entry-line {
  width: 12px;
  height: 12px;
  border: 1px solid var(--paper);
  border-radius: 50%;
}

.story-entry strong {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 15px;
  font-weight: 400;
}

.story-entry small {
  color: var(--yellow);
  font: 9px/1 "Consolas", "Courier New", monospace;
}

.detail-panel {
  position: absolute;
  right: clamp(24px, 5vw, 80px);
  bottom: clamp(78px, 10vh, 122px);
  width: min(342px, calc(100vw - 48px));
  max-height: min(58vh, 510px);
  padding: 18px;
  overflow: auto;
  border: 1px solid rgba(237, 241, 243, 0.52);
  background: rgba(8, 13, 18, 0.83);
  box-shadow: var(--shadow);
  opacity: 0;
  pointer-events: none;
  transform: translateY(12px);
  transition: opacity 180ms ease, transform 180ms ease;
  backdrop-filter: blur(15px);
}

.detail-panel.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.panel-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--paper-dim);
}

.panel-close {
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border-color: transparent;
  font-size: 18px;
  line-height: 1;
}

.panel-title {
  margin: 26px 0 10px;
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 36px;
  font-weight: 400;
  line-height: 0.94;
}

.panel-subtitle {
  margin: 0;
  color: var(--paper-dim);
  font-size: 13px;
  line-height: 1.7;
}

.panel-rule {
  height: 1px;
  margin: 18px 0;
  background: var(--line-soft);
}

.panel-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.stat-cell {
  padding: 11px;
  border: 1px solid var(--line-soft);
}

.stat-cell small,
.stat-cell strong {
  display: block;
}

.stat-cell small {
  color: var(--paper-dim);
  font: 9px/1 "Consolas", "Courier New", monospace;
  letter-spacing: 0.08em;
}

.stat-cell strong {
  margin-top: 9px;
  font: 600 16px/1 "Consolas", "Courier New", monospace;
}

.panel-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 18px;
  padding: 12px 13px;
  border: 1px solid var(--blue-light);
  color: var(--paper);
  background: rgba(43, 105, 167, 0.36);
  cursor: pointer;
  font-size: 13px;
  text-align: left;
  transition: background 180ms ease, border-color 180ms ease;
}

.panel-action:hover {
  border-color: var(--yellow);
  background: rgba(43, 105, 167, 0.64);
}

.panel-action.is-done {
  border-color: var(--yellow);
  color: var(--yellow);
}

.article-copy {
  margin: 22px 0 0;
  color: rgba(237, 241, 243, 0.84);
  font-size: 14px;
  line-height: 1.95;
  white-space: pre-line;
}

.control-dock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  min-height: 64px;
  padding: 10px 24px 12px 18px;
  border-top: 1px solid var(--line-soft);
  background: rgba(6, 11, 16, 0.82);
  backdrop-filter: blur(12px);
}

.dock-left,
.dock-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.dock-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  border-color: var(--line-soft);
}

.play-glyph {
  display: block;
  width: 0;
  height: 0;
  margin-left: 3px;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
  border-left: 9px solid currentColor;
}

.is-playing .play-glyph {
  width: 11px;
  height: 13px;
  margin: 0;
  border: 0;
  background: linear-gradient(90deg, currentColor 0 3px, transparent 3px 8px, currentColor 8px 11px);
}

.sound-glyph {
  position: relative;
  display: block;
  width: 16px;
  height: 14px;
  border-left: 5px solid currentColor;
  border-top: 5px solid transparent;
  border-bottom: 5px solid transparent;
}

.sound-glyph::after {
  position: absolute;
  top: -7px;
  left: 4px;
  width: 10px;
  height: 14px;
  content: "";
  border-right: 1px solid currentColor;
  border-radius: 50%;
}

.is-muted .sound-glyph::before {
  position: absolute;
  top: 6px;
  left: 6px;
  width: 14px;
  height: 1px;
  content: "";
  background: var(--red);
  transform: rotate(-45deg);
}

.reset-glyph {
  font-size: 22px;
  line-height: 1;
}

.runtime {
  display: grid;
  gap: 7px;
  width: min(430px, 36vw);
}

.runtime-label {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  color: var(--paper-dim);
}

.runtime-label output {
  color: var(--paper);
  letter-spacing: 0.04em;
}

#progressRange {
  width: 100%;
  height: 5px;
  accent-color: var(--red);
  cursor: pointer;
}

.dock-copy {
  color: var(--paper-dim);
  white-space: nowrap;
}

.toast {
  position: fixed;
  z-index: 15;
  right: 24px;
  bottom: 84px;
  max-width: min(320px, calc(100vw - 48px));
  padding: 10px 13px;
  border: 1px solid var(--yellow);
  color: var(--paper);
  background: rgba(12, 18, 24, 0.92);
  font-size: 12px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px);
  transition: opacity 180ms ease, transform 180ms ease;
}

.toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 980px) {
  body {
    overflow: auto;
  }

  .app-shell {
    min-height: 900px;
  }

  .main-stage {
    min-height: 830px;
  }

  .stage-heading {
    top: 7vh;
    left: 24px;
    width: min(420px, 58vw);
  }

  .scene-nav {
    top: auto;
    right: 24px;
    bottom: 26%;
    transform: none;
  }

  .center-readout {
    bottom: 12%;
  }

  .detail-panel {
    bottom: 90px;
  }
}

@media (max-width: 720px) {
  .app-shell {
    min-height: 980px;
  }

  .topbar {
    min-height: 68px;
    padding: 10px 12px;
  }

  .square-button {
    width: 44px;
    min-width: 44px;
    font-size: 30px;
  }

  .home-button {
    min-width: 0;
    padding: 9px 12px;
  }

  .home-button small,
  .topbar-status {
    display: none;
  }

  .home-mark {
    width: 24px;
    height: 24px;
  }

  .stage-heading {
    top: 4vh;
    left: 18px;
    width: calc(100% - 36px);
  }

  .stage-heading h1 {
    max-width: 250px;
    font-size: clamp(54px, 18vw, 86px);
  }

  .stage-heading p {
    max-width: 280px;
    margin-top: 16px;
    font-size: 13px;
  }

  .top-note {
    top: 3.5vh;
    right: 18px;
    gap: 7px;
    font-size: 9px;
  }

  .top-note-line {
    width: 30px;
  }

  .scene-nav {
    right: 18px;
    bottom: 26%;
    width: 176px;
    gap: 6px;
  }

  .scene-tab {
    min-height: 48px;
    padding: 7px 8px;
    grid-template-columns: 28px 1fr;
    gap: 8px;
  }

  .tab-index {
    width: 24px;
    height: 24px;
  }

  .tab-copy strong {
    font-size: 12px;
  }

  .tab-copy small {
    margin-top: 3px;
    font-size: 8px;
  }

  .center-readout {
    bottom: 10%;
    max-width: 210px;
  }

  .hotspot {
    min-width: 138px;
    grid-template-columns: 34px 1fr;
    gap: 7px;
    padding: 5px 7px 5px 5px;
  }

  .hotspot-icon {
    width: 32px;
    height: 32px;
    font-size: 11px;
  }

  .hotspot strong {
    font-size: 11px;
  }

  .hotspot small {
    font-size: 7px;
  }

  .hotspot-map {
    right: 44%;
    bottom: 12%;
  }

  .hotspot-orders {
    right: 4%;
    top: 22%;
  }

  .hotspot-story {
    left: 8%;
    bottom: 19%;
  }

  .hotspot-notebook {
    left: 5%;
    top: 30%;
  }

  #appShell[data-scene="map"] .interaction-layer,
  #appShell[data-scene="orders"] .interaction-layer,
  #appShell[data-scene="notebook"] .interaction-layer {
    top: 34%;
    right: 18px;
    bottom: auto;
    left: 18px;
    display: grid;
    gap: 6px;
    max-height: 320px;
    overflow: auto;
    padding-right: 3px;
  }

  #appShell[data-scene="map"] .interaction-layer {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .map-node {
    position: relative;
    inset: auto !important;
    min-width: 0;
    width: 100%;
    box-shadow: none;
  }

  .order-stack,
  .story-stack {
    position: relative;
    top: auto;
    right: auto;
    width: 100%;
  }

  .detail-panel {
    right: 18px;
    bottom: 82px;
    width: calc(100vw - 36px);
    max-height: 42vh;
  }

  .control-dock {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 10px 12px;
  }

  .dock-left,
  .dock-right {
    width: 100%;
  }

  .runtime {
    width: 100%;
  }

  .dock-right {
    justify-content: flex-end;
  }

  .dock-copy {
    margin-right: auto;
    font-size: 9px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
